import cv2
import matplotlib.pyplot as plt
import os
import numpy as np


# ===== IMAGE LOADING =====
image_path = '/content/drive/MyDrive/Sem 8/Rs_exp_5/Copy of LC08_L1TP_056016_20250304_20250304_02_RT_B3 (1).TIF'

if not os.path.exists(image_path):
    print("Error: File not found")
else:
    image = cv2.imread(image_path)


# ===== ORIGINAL BAND DISPLAY =====
plt.figure(figsize=(10, 8))
plt.imshow(image[:, :, 0], cmap='gray')
plt.title('Original Band 3 Image')
plt.axis('off')
plt.show()


# ===== BAND EXTRACTION =====
band3_image = image[:, :, 0]

if band3_image.dtype != 'uint8':
    band3_image_uint8 = cv2.convertScaleAbs(band3_image)
else:
    band3_image_uint8 = band3_image


# ===== HISTOGRAM EQUALIZATION =====
contrast_stretched_band3 = cv2.equalizeHist(band3_image_uint8)

plt.figure(figsize=(10, 8))
plt.imshow(contrast_stretched_band3, cmap='gray')
plt.title('Contrast-Stretched Band 3 Image')
plt.axis('off')
plt.show()


# ===== HISTOGRAM PLOT =====
hist, bins = np.histogram(contrast_stretched_band3.flatten(), bins=256, range=(0, 255))

plt.figure(figsize=(10, 6))
plt.plot(bins[:-1], hist)
plt.title('Histogram of Contrast-Stretched Image')
plt.xlabel('Pixel Intensity')
plt.ylabel('Frequency')
plt.grid()
plt.show()


# ===== THRESHOLDING =====
_, thresholded_image = cv2.threshold(contrast_stretched_band3, 127, 255, cv2.THRESH_BINARY)

plt.figure(figsize=(10, 8))
plt.imshow(thresholded_image, cmap='gray')
plt.title('Thresholded Image')
plt.axis('off')
plt.show()


