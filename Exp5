import cv2
import numpy as np
import matplotlib.pyplot as plt
from skimage.metrics import peak_signal_noise_ratio as psnr


# ===== IMAGE LOADING =====
image = cv2.imread('/content/drive/MyDrive/Sem 8/india-outlined-highres-satellite-map-260nw-2406056235.webp')
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
print("Image Shape:", image.shape)


# ===== GRAYSCALE CONVERSION =====
gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image.copy()
gray = cv2.normalize(gray, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)


# ===== ROBERTS EDGE DETECTION =====
roberts_x = cv2.filter2D(gray, cv2.CV_32F, np.array([[1, 0],[0, -1]], dtype=np.float32))
roberts_y = cv2.filter2D(gray, cv2.CV_32F, np.array([[0, -1],[1, 0]], dtype=np.float32))
roberts = cv2.normalize(cv2.magnitude(roberts_x, roberts_y), None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)


# ===== PREWITT EDGE DETECTION =====
prewitt_x = cv2.filter2D(gray, cv2.CV_32F, np.array([[-1,0,1],[-1,0,1],[-1,0,1]], dtype=np.float32))
prewitt_y = cv2.filter2D(gray, cv2.CV_32F, np.array([[-1,-1,-1],[0,0,0],[1,1,1]], dtype=np.float32))
prewitt = cv2.normalize(cv2.magnitude(prewitt_x, prewitt_y), None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)


# ===== SOBEL EDGE DETECTION =====
sobel_x = cv2.Sobel(gray, cv2.CV_32F, 1, 0, ksize=3)
sobel_y = cv2.Sobel(gray, cv2.CV_32F, 0, 1, ksize=3)
sobel = cv2.normalize(cv2.magnitude(sobel_x, sobel_y), None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)


# ===== EDGE DISPLAY =====
plt.figure(figsize=(15, 8))
titles = ["Gray", "Roberts", "Prewitt", "Sobel"]
images = [gray, roberts, prewitt, sobel]
for i in range(4):
    plt.subplot(2, 2, i + 1)
    plt.imshow(images[i], cmap='gray')
    plt.title(titles[i])
    plt.axis("off")
plt.tight_layout()
plt.show()


# ===== CANNY EDGE DETECTION =====
blurred = cv2.GaussianBlur(gray, (5, 5), 1.4)
edges = cv2.Canny(blurred, 100, 200)

plt.figure(figsize=(10, 5))
plt.subplot(1, 2, 1)
plt.imshow(gray, cmap='gray')
plt.axis("off")
plt.title("Gray")

plt.subplot(1, 2, 2)
plt.imshow(edges, cmap='gray')
plt.axis("off")
plt.title("Canny")
plt.show()


# ===== SMOOTHING FILTERS =====
avg = cv2.blur(image, (5, 5))
gaussian = cv2.GaussianBlur(image, (5, 5), 0)
median = cv2.medianBlur(image, 5)
bilateral = cv2.bilateralFilter(image, 9, 75, 75)

plt.figure(figsize=(15, 8))
imgs = [image, avg, gaussian, median, bilateral]
titles = ["Original", "Average", "Gaussian", "Median", "Bilateral"]

for i in range(5):
    plt.subplot(2, 3, i+1)
    plt.imshow(cv2.cvtColor(imgs[i], cv2.COLOR_BGR2RGB))
    plt.title(titles[i])
    plt.axis("off")
plt.tight_layout()
plt.show()


# ===== GAUSSIAN NOISE ADDITION =====
noise = np.random.normal(0, 150, image.shape).astype(np.uint8)
noisy = cv2.add(image, noise)

plt.figure(figsize=(15, 5))
plt.subplot(1, 3, 1)
plt.imshow(image_rgb)
plt.title("Original")

plt.subplot(1, 3, 2)
plt.imshow(noise)
plt.title("Noise")

plt.subplot(1, 3, 3)
plt.imshow(cv2.cvtColor(noisy, cv2.COLOR_BGR2RGB))
plt.title("Noisy")
plt.show()


# ===== HISTOGRAM EQUALIZATION & OTSU =====
equalized = cv2.equalizeHist(gray)
_, otsu = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)

plt.figure(figsize=(15, 5))
plt.subplot(1, 3, 1)
plt.imshow(gray, cmap='gray')

plt.subplot(1, 3, 2)
plt.imshow(equalized, cmap='gray')

plt.subplot(1, 3, 3)
plt.imshow(otsu, cmap='gray')
plt.show()


# ===== MORPHOLOGICAL OPERATIONS =====
kernel = np.ones((5, 5), np.uint8)
eroded = cv2.erode(otsu, kernel, 1)
dilated = cv2.dilate(otsu, kernel, 1)

plt.figure(figsize=(15, 5))
plt.subplot(1, 3, 1)
plt.imshow(otsu, cmap='gray')

plt.subplot(1, 3, 2)
plt.imshow(eroded, cmap='gray')

plt.subplot(1, 3, 3)
plt.imshow(dilated, cmap='gray')
plt.show()


# ===== FINAL COMPARISON =====
plt.figure(figsize=(20, 5))
imgs = [gray, equalized, otsu, eroded, dilated]

for i in range(5):
    plt.subplot(1, 5, i+1)
    plt.imshow(imgs[i], cmap='gray')
    plt.axis('off')
plt.show()    


